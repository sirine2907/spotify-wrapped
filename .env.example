# get this from https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here

# must match the redirect uri in your spotify app settings
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# used for og images / sitemap (your vercel url in production)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
